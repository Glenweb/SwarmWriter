# ─────────────────────────────────────────────────────────────────────────────
# Swarm Writer — environment
# Copy to .env.local. EVERY key is optional for local dev: anything left blank
# falls back to a deterministic mock provider so the full pipeline still runs.
# Check live status any time at /api/health.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------------------
# 32+ char secret used to sign session cookies and encrypt WP app passwords.
# Leave blank locally and a stable dev key is derived automatically.
AUTH_SECRET=
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Neon Postgres in production. Leave blank and Swarm Writer boots an embedded
# Postgres (PGlite) into ./.pgdata — identical SQL dialect, zero setup.
#   Neon:  postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/swarmwriter?sslmode=require
DATABASE_URL=

# --- Anthropic (article generation) -----------------------------------------
# Blank => MockAnthropic: full multi-agent pipeline, real structure, no spend.
ANTHROPIC_API_KEY=
MODEL_HAIKU=claude-haiku-4-5-20251001
MODEL_SONNET=claude-sonnet-5-5
MODEL_OPUS=claude-opus-5-5
# Tier mix targets (share of generation steps). Cost target $0.039/article.
TIER_MIX_HAIKU=0.70
TIER_MIX_SONNET=0.28
TIER_MIX_OPUS=0.02
ARTICLE_COST_TARGET_USD=0.039

# --- DataForSEO (keywords + SERP) -------------------------------------------
# Blank => MockDataForSEO: deterministic volumes/difficulty from the seed term.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=2826
DATAFORSEO_LANGUAGE_CODE=en

# --- Stripe (credit billing) ------------------------------------------------
# Blank => mock checkout that credits the account instantly for local testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# --- Scheduling (n8n) -------------------------------------------------------
# Shared secret for POST /api/cron/* called by gmkmedia.app.n8n.cloud.
CRON_SECRET=
N8N_BASE_URL=https://gmkmedia.app.n8n.cloud
N8N_WEBHOOK_PATH=/webhook/swarm-writer

# --- Safety rails -----------------------------------------------------------
# true  => never POSTs to WordPress, records the exact payload instead.
WORDPRESS_DRY_RUN=false
# Seed a demo workspace on `npm run db:seed`.
SEED_DEMO_USER=demo@gmkmedia.co.uk
SEED_DEMO_PASSWORD=swarmwriter
